{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {},
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "strm.touchnmotion.fabric.TouchNMotionFabric"
    ],
    "preLaunch": [
      "strm.touchnmotion.fabric.Requirements"
    ],
    "client": [
      "strm.touchnmotion.fabric.TouchNMotionFabricClient"
    ],
    "modmenu": [
      "strm.touchnmotion.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "touch_n_motion.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}"
  },
  "suggests": {
    "entity_model_features": ">=${emf_version}",
    "emf_compat_core": ">=2.2.0"
  }
}
