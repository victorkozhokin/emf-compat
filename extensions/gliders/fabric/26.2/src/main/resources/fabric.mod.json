{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {},
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "strm.emfcompat.gliders.GlidersEMFCompat"
    ]
  },
  "mixins": [
    "emf_compat_gliders.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "entity_model_features": ">=${emf_version}",
    "emf_compat_core": ">=2.0.0"
  },
  "suggests": {
    "reliable_gliders": "*"
  }
}
